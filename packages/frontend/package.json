    "eslint-plugin-oxlint": "~1.23.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.23.0",
    "prettier": "3.6.2",
    "sass-embedded": "^1.97.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "vite": "npm:rolldown-vite@latest",
