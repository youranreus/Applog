#!/usr/bin/env bash

set -Eeuo pipefail

readonly service_unit="applog-garmin-sync.service"
readonly timer_unit="applog-garmin-sync.timer"
worker_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
timer_bin="${GARMIN_MIGRATION_TIMER_BIN:-${worker_dir}/manage-timer}"
systemctl_bin="${GARMIN_MIGRATION_SYSTEMCTL_BIN:-$(command -v systemctl || true)}"

usage() {
  cat <<'EOF'
Usage:
  migrate-app-secret apply (--env-file PATH | --env-dir PATH) --backup-id ID
                           [--venv PATH] [--dry-run]
  migrate-app-secret rollback (--env-file PATH | --env-dir PATH) --backup-id ID
                              [--venv PATH] [--dry-run]

Successful apply and rollback operations leave the Garmin timer disabled.
EOF
}

fail() { echo "Encryption migration: $*" >&2; exit 1; }
announce() { echo "Phase: ${phase}"; }
phase="arguments"
mutating=false
backup_started=false
completed=false

next_step() {
  if [[ "${command_name}" == "apply" && "${backup_started}" == false ]]; then
    printf 'Next step: rerun %q' "$0"
    printf ' %q' "${original_args[@]}"
    printf '\n'
  else
    printf 'Next step: sudo %q rollback' "$0"
    printf ' %q' "${environment_args[@]}" --backup-id "${backup_id}" --venv "${venv_dir}"
    printf '\n'
  fi
}

on_exit() {
  local status=$?
  if [[ ${status} -ne 0 && "${mutating}" == true && "${completed}" == false ]]; then
    "${timer_bin}" disable >/dev/null 2>&1 || true
    echo "Migration stopped during phase: ${phase}. The Garmin timer remains disabled." >&2
    next_step >&2
  fi
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

original_args=("$@")
command_name="${1:-}"
case "${command_name}" in apply|rollback) shift ;; -h|--help|help) usage; exit 0 ;; *) usage >&2; fail "expected apply or rollback" ;; esac

env_file=""
env_dir=""
backup_id=""
venv_dir="/opt/applog/venvs/garmin-sync"
dry_run=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file) [[ $# -ge 2 ]] || fail "--env-file requires a path"; env_file="$2"; shift 2 ;;
    --env-dir) [[ $# -ge 2 ]] || fail "--env-dir requires a path"; env_dir="$2"; shift 2 ;;
    --backup-id) [[ $# -ge 2 ]] || fail "--backup-id requires a value"; backup_id="$2"; shift 2 ;;
    --venv) [[ $# -ge 2 ]] || fail "--venv requires a path"; venv_dir="$2"; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

[[ -n "${env_file}" || -n "${env_dir}" ]] || fail "select --env-file or --env-dir"
[[ -z "${env_file}" || -z "${env_dir}" ]] || fail "--env-file and --env-dir are mutually exclusive"
[[ "${backup_id}" =~ ^[A-Za-z0-9_]{1,48}$ ]] || fail "invalid backup id"
[[ -x "${timer_bin}" ]] || fail "manage-timer is not executable"
[[ -n "${systemctl_bin}" && -x "${systemctl_bin}" ]] || fail "systemctl is not available"
manage_encryption="${venv_dir}/bin/manage-encryption"
[[ -x "${manage_encryption}" ]] || fail "manage-encryption is not executable in the selected venv"
if [[ -n "${env_file}" ]]; then
  [[ "${env_file}" = /* && -f "${env_file}" ]] || fail "environment file must be an existing absolute path"
  environment_args=(--env-file "${env_file}")
else
  [[ "${env_dir}" = /* && -d "${env_dir}" ]] || fail "environment directory must be an existing absolute path"
  environment_args=(--env-dir "${env_dir}")
fi

phase="systemd preflight"
announce
"${systemctl_bin}" cat "${timer_unit}" >/dev/null
"${systemctl_bin}" cat "${service_unit}" >/dev/null

if [[ "${dry_run}" == true ]]; then
  if [[ "${command_name}" == "apply" ]]; then
    phase="cryptographic preflight"
    announce
    "${manage_encryption}" "${environment_args[@]}" preflight --dry-run
    phase="migration dry-run"
    announce
    "${manage_encryption}" "${environment_args[@]}" migrate --backup-id "${backup_id}" --dry-run
  else
    phase="rollback preflight"
    announce
    "${manage_encryption}" "${environment_args[@]}" rollback --backup-id "${backup_id}" --dry-run
  fi
  if "${systemctl_bin}" is-active --quiet "${timer_unit}"; then
    echo "Dry-run complete. Apply would disable the active Garmin timer."
  else
    echo "Dry-run complete. No scheduler or database changes were made."
  fi
  completed=true
  exit 0
fi

if [[ ${EUID} -ne 0 && "${GARMIN_MIGRATION_TEST_MODE:-}" != "1" ]]; then
  fail "mutating operations must be run with sudo or as root"
fi
mutating=true
phase="scheduler shutdown"
announce
"${timer_bin}" disable
"${systemctl_bin}" stop "${service_unit}"
if "${systemctl_bin}" is-active --quiet "${timer_unit}" || "${systemctl_bin}" is-active --quiet "${service_unit}"; then
  fail "Garmin timer or worker is still active"
fi

if [[ "${command_name}" == "rollback" ]]; then
  phase="rollback preflight"
  announce
  "${manage_encryption}" "${environment_args[@]}" rollback --backup-id "${backup_id}" --dry-run
  phase="rollback"
  announce
  backup_started=true
  "${manage_encryption}" "${environment_args[@]}" rollback --backup-id "${backup_id}"
  completed=true
  echo "Rollback verified. The Garmin timer remains disabled."
  echo "Deploy the compatible legacy worker before enabling the timer."
else
  phase="cryptographic preflight"
  announce
  "${manage_encryption}" "${environment_args[@]}" preflight --dry-run
  phase="migration dry-run"
  announce
  "${manage_encryption}" "${environment_args[@]}" migrate --backup-id "${backup_id}" --dry-run
  phase="migration"
  announce
  backup_started=true
  "${manage_encryption}" "${environment_args[@]}" migrate --backup-id "${backup_id}"
  phase="verification"
  announce
  "${manage_encryption}" "${environment_args[@]}" verify --backup-id "${backup_id}"
  phase="controlled synchronization"
  announce
  "${systemctl_bin}" start "${service_unit}"
  active_state="$("${systemctl_bin}" show "${service_unit}" -p ActiveState --value)"
  result="$("${systemctl_bin}" show "${service_unit}" -p Result --value)"
  main_status="$("${systemctl_bin}" show "${service_unit}" -p ExecMainStatus --value)"
  [[ "${active_state}" == "inactive" && "${result}" == "success" && "${main_status}" == "0" ]] ||
    fail "controlled Garmin synchronization did not complete successfully"
  phase="post-sync verification"
  announce
  "${manage_encryption}" "${environment_args[@]}" verify --backup-id "${backup_id}"
  if "${systemctl_bin}" is-active --quiet "${timer_unit}"; then
    fail "Garmin timer became active unexpectedly"
  fi
  completed=true
  echo "Migration and controlled synchronization verified for backup ${backup_id}."
  echo "The Garmin timer remains disabled. Review the output, then run:"
fi

printf '  sudo %q enable\n' "${timer_bin}"
printf '  %q status\n' "${timer_bin}"
