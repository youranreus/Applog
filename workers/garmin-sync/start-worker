#!/usr/bin/env bash

set -euo pipefail

worker_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$(cd -- "${worker_dir}/../.." && pwd)"
env_dir="${GARMIN_ENV_DIR:-${project_dir}/packages/backend}"
env_file="${GARMIN_ENV_FILE:-}"
python_bin="${GARMIN_PYTHON_BIN:-${worker_dir}/.venv/bin/python}"

if [[ -n "${env_file}" ]]; then
  if [[ ! -f "${env_file}" ]]; then
    echo "Garmin environment file not found: ${env_file}" >&2
    exit 1
  fi
  env_args=(--env-file "${env_file}")
else
  if [[ ! -d "${env_dir}" ]]; then
    echo "Garmin environment directory not found: ${env_dir}" >&2
    exit 1
  fi
  env_args=(--env-dir "${env_dir}")
fi

if [[ ! -x "${python_bin}" ]]; then
  echo "Garmin Python executable not found: ${python_bin}" >&2
  echo "Set GARMIN_PYTHON_BIN to the worker virtualenv Python path." >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  set -- sync
fi

exec "${python_bin}" -m garmin_sync.cli "${env_args[@]}" "$@"
