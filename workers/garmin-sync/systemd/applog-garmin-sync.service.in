[Unit]
Description=AppLog Garmin activity snapshot sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@WORKER_DIR@
Environment="GARMIN_PYTHON_BIN=@PYTHON_BIN@"
Environment="GARMIN_ENV_DIR=@ENV_DIR@"
Environment="GARMIN_ENV_FILE=@ENV_FILE@"
ExecStartPre=-@WORKER_DIR@/start-worker map-health
ExecStart=@WORKER_DIR@/start-worker sync
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
